{
  "name": "scip-lab-course-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node scripts/test_unit.mjs",
    "dev": "npm --prefix web run dev",
    "test:database": "node tests/test_grading_database.mjs",
    "test:grading": "node tests/test_grading_state.cjs && node tests/test_grading_api.cjs",
    "test:similarity": "python scripts/audit_similarity.py --help",
    "build": "npm --prefix web run build",
    "build:portal": "node scripts/build_portal.mjs",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "test:parity": "python scripts/parity_report.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@supabase/supabase-js": "2.118.0",
    "esbuild": "0.25.11",
    "katex": "0.19.1",
    "pg": "8.16.3",
    "playwright": "1.55.1"
  }
}
